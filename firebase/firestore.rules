rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function profileEmail() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower()
        : '';
    }

    function accountEmail() {
      return userEmail() != '' ? userEmail() : profileEmail();
    }

    function isMemberViaSubcollection(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() && (
        isMemberViaSubcollection(householdId) ||
        (
          get(/databases/$(database)/documents/households/$(householdId)).data.memberIds != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds
        )
      );
    }

    function inviteDoc(inviteId) {
      return get(/databases/$(database)/documents/invites/$(inviteId)).data;
    }

    function householdCreator(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data.createdBy;
    }

    function isJoiningMemberIds() {
      return resource.data.memberIds != null &&
        request.auth.uid in request.resource.data.memberIds &&
        !(request.auth.uid in resource.data.memberIds) &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
    }

    function validPendingInvite(inviteId, householdId) {
      return exists(/databases/$(database)/documents/invites/$(inviteId)) &&
        inviteDoc(inviteId).status == 'pending' &&
        inviteDoc(inviteId).email == accountEmail() &&
        inviteDoc(inviteId).householdId == householdId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    match /inviteLinks/{token} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.inviteId is string &&
        request.resource.data.email is string &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)) &&
        inviteDoc(request.resource.data.inviteId).status == 'pending' &&
        isHouseholdMember(inviteDoc(request.resource.data.inviteId).householdId);
      allow delete: if isSignedIn() &&
        resource.data.inviteId is string &&
        exists(/databases/$(database)/documents/invites/$(resource.data.inviteId)) &&
        isHouseholdMember(inviteDoc(resource.data.inviteId).householdId);
    }

    match /households/{householdId} {
      allow read: if isSignedIn() && (
        isMemberViaSubcollection(householdId) ||
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
      );
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) ||
        (isMemberViaSubcollection(householdId) && isJoiningMemberIds())
      );
      allow delete: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid;

      match /members/{memberUserId} {
        allow read: if isSignedIn() && (
          request.auth.uid == memberUserId ||
          isHouseholdMember(householdId)
        );
        allow create: if isSignedIn() &&
          request.auth.uid == memberUserId &&
          request.resource.data.userId == request.auth.uid &&
          (
            (
              request.resource.data.inviteId is string &&
              validPendingInvite(request.resource.data.inviteId, householdId)
            ) ||
            (
              get(/databases/$(database)/documents/households/$(householdId)).data.memberIds != null &&
              request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds &&
              !exists(/databases/$(database)/documents/households/$(householdId)/members/$(memberUserId))
            )
          );
        allow update: if isSignedIn() && request.auth.uid == memberUserId;
        allow delete: if isSignedIn() && (
          request.auth.uid == memberUserId ||
          (
            get(/databases/$(database)/documents/households/$(householdId)).data.memberIds != null &&
            request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds
          )
        );
      }
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId) &&
        request.resource.data.createdBy == request.auth.uid;
      allow delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId) &&
        (
          resource.data.createdBy == request.auth.uid ||
          householdCreator(resource.data.householdId) == request.auth.uid
        );
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.email == accountEmail() ||
        isHouseholdMember(resource.data.householdId)
      );
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId) &&
        request.resource.data.invitedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
        (
          resource.data.email == accountEmail() &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'declined']
        ) ||
        isHouseholdMember(resource.data.householdId)
      );
      allow delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
    }
  }
}
