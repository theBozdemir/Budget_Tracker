rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The account's email, but only once the person has proved they own it.
    // Invites are matched by email, so an unverified address must never count:
    // otherwise anyone could sign up with an invitee's email and take the invite.
    function accountEmail() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true
        ? request.auth.token.email.lower()
        : '';
    }

    function isInvitee(inviteEmail) {
      return accountEmail() != '' && inviteEmail == accountEmail();
    }

    function isMemberViaSubcollection(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() && (
        isMemberViaSubcollection(householdId) ||
        (
          get(/databases/$(database)/documents/households/$(householdId)).data.memberIds != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds
        )
      );
    }

    function inviteDoc(inviteId) {
      return get(/databases/$(database)/documents/invites/$(inviteId)).data;
    }

    function householdCreator(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data.createdBy;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Leaving: exactly the signed-in user removed from memberIds, nobody else
    function removesOnlySelf() {
      return request.auth.uid in resource.data.memberIds &&
        resource.data.memberIds.removeAll([request.auth.uid]).toSet() == request.resource.data.memberIds.toSet() &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;
    }

    // Joining: exactly the signed-in user added to memberIds, nobody else
    function addsOnlySelf() {
      return !(request.auth.uid in resource.data.memberIds) &&
        request.resource.data.memberIds.toSet() == resource.data.memberIds.concat([request.auth.uid]).toSet() &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
    }

    function isStringUpTo(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validTransaction(data) {
      return data.keys().hasAll(['householdId', 'amount', 'type', 'category', 'createdBy']) &&
        data.keys().hasOnly([
          'householdId', 'amount', 'type', 'category', 'note',
          'timestamp', 'createdBy', 'createdByName', 'createdAt',
          'updatedBy', 'updatedAt'
        ]) &&
        data.householdId is string &&
        data.amount is number && data.amount > -1000000000000 && data.amount < 1000000000000 &&
        data.type in ['expense', 'income'] &&
        isStringUpTo(data.category, 100) && data.category.size() > 0 &&
        (!('note' in data) || isStringUpTo(data.note, 1000)) &&
        (!('createdByName' in data) || isStringUpTo(data.createdByName, 100)) &&
        (!('timestamp' in data) || data.timestamp is timestamp) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validPendingInvite(inviteId, householdId) {
      return exists(/databases/$(database)/documents/invites/$(inviteId)) &&
        inviteDoc(inviteId).status == 'pending' &&
        isInvitee(inviteDoc(inviteId).email) &&
        inviteDoc(inviteId).householdId == householdId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /inviteLinks/{token} {
      // Only fetch by the token from an invite link; never list them all
      allow get: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.inviteId is string &&
        request.resource.data.email is string &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)) &&
        inviteDoc(request.resource.data.inviteId).status == 'pending' &&
        isHouseholdMember(inviteDoc(request.resource.data.inviteId).householdId);
      // The app deletes the invite first, so check the household stored on the link itself
      allow delete: if isSignedIn() &&
        resource.data.householdId is string &&
        isHouseholdMember(resource.data.householdId);
    }

    match /households/{householdId} {
      allow read: if isSignedIn() && (
        isMemberViaSubcollection(householdId) ||
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
      );
      allow create: if isSignedIn() &&
        request.resource.data.memberIds == [request.auth.uid] &&
        request.resource.data.createdBy == request.auth.uid &&
        isStringUpTo(request.resource.data.name, 100);
      // Members can change settings and leave; joiners can only add themselves.
      // Nobody can change who created the household or add/remove other people.
      allow update: if isSignedIn() &&
        resource.data.memberIds != null &&
        request.resource.data.memberIds is list &&
        !changedKeys().hasAny(['createdBy', 'createdAt']) &&
        (
          (
            request.auth.uid in resource.data.memberIds &&
            changedKeys().hasOnly([
              'name', 'currency', 'expenseCategories', 'incomeCategories',
              'pendingInviteEmails', 'joinInviteFor', 'memberIds'
            ]) &&
            (!changedKeys().hasAny(['memberIds']) || removesOnlySelf())
          ) ||
          (
            isMemberViaSubcollection(householdId) &&
            changedKeys().hasOnly(['memberIds']) &&
            addsOnlySelf()
          )
        );
      allow delete: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid;

      match /members/{memberUserId} {
        allow read: if isSignedIn() && (
          request.auth.uid == memberUserId ||
          isHouseholdMember(householdId)
        );
        allow create: if isSignedIn() &&
          request.auth.uid == memberUserId &&
          request.resource.data.userId == request.auth.uid &&
          (
            (
              request.resource.data.inviteId is string &&
              validPendingInvite(request.resource.data.inviteId, householdId)
            ) ||
            (
              get(/databases/$(database)/documents/households/$(householdId)).data.memberIds != null &&
              request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds &&
              !exists(/databases/$(database)/documents/households/$(householdId)/members/$(memberUserId))
            )
          );
        allow update: if isSignedIn() &&
          request.auth.uid == memberUserId &&
          !changedKeys().hasAny(['userId']);
        // Leave yourself, or the household creator cleans up when deleting the household
        allow delete: if isSignedIn() && (
          request.auth.uid == memberUserId ||
          householdCreator(householdId) == request.auth.uid
        );
      }
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        validTransaction(request.resource.data) &&
        isHouseholdMember(request.resource.data.householdId) &&
        request.resource.data.createdBy == request.auth.uid;
      // The person who added an entry, or the household owner, can edit it.
      // Which household it belongs to and who added it never change.
      allow update: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId) &&
        (
          resource.data.createdBy == request.auth.uid ||
          householdCreator(resource.data.householdId) == request.auth.uid
        ) &&
        changedKeys().hasOnly(['amount', 'type', 'category', 'note', 'timestamp', 'updatedBy', 'updatedAt']) &&
        request.resource.data.updatedBy == request.auth.uid &&
        validTransaction(request.resource.data);
      allow delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId) &&
        (
          resource.data.createdBy == request.auth.uid ||
          householdCreator(resource.data.householdId) == request.auth.uid
        );
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() && (
        isInvitee(resource.data.email) ||
        isHouseholdMember(resource.data.householdId)
      );
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId) &&
        request.resource.data.invitedBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        isStringUpTo(request.resource.data.email, 254) &&
        request.resource.data.email.size() > 3;
      // Only the invited person answers an invite, and only the status changes
      allow update: if isSignedIn() &&
        isInvitee(resource.data.email) &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'declined'] &&
        changedKeys().hasOnly(['status', 'acceptedAt', 'declinedAt']);
      allow delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
    }
  }
}
